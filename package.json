{
  "name": "agent-harness",
  "version": "0.2.0",
  "description": "把既有專案的功能包成工具，交給聊天 agent 使用的輕量框架",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "harness": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.54.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
